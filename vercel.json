{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pulmonologist",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pulmonologist/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "functions": {
    "api/pubmed.js": {
      "maxDuration": 60
    },
    "api/claude.js": {
      "maxDuration": 60
    },
    "api/telegram.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/telegram?action=digest",
      "schedule": "50 4 * * *"
    }
  ]
}
