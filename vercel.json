{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pulmonologist",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pulmonologist/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "functions": {
    "api/pubmed.js": {
      "maxDuration": 60
    },
    "api/claude.js": {
      "maxDuration": 300
    },
    "api/research.js": {
      "maxDuration": 300
    },
    "api/search.js": {
      "maxDuration": 60
    },
    "api/updates.js": {
      "maxDuration": 60
    },
    "api/verify.js": {
      "maxDuration": 60
    },
    "api/books.js": {
      "maxDuration": 30
    },
    "api/sources.js": {
      "maxDuration": 30
    },
    "api/docs.js": {
      "maxDuration": 30
    }
  }
}