{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/pulmonologist/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/pulmonologist/"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pulmonologist",
      "destination": "/pulmonologist/",
      "permanent": false
    }
  ],
  "functions": {
    "api/pubmed.js": {
      "maxDuration": 60
    },
    "api/claude.js": {
      "maxDuration": 60
    }
  }
}
